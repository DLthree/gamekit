{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "stickRadius": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "stickDeadZone": {
      "type": "number",
      "minimum": 0
    },
    "buttonRadius": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "knobRadius": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cancelColor": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "aim": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "cooldownColor": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "color",
        "cooldownColor",
        "alpha",
        "width"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "stickRadius",
    "stickDeadZone",
    "buttonRadius",
    "knobRadius",
    "cancelColor",
    "aim"
  ],
  "additionalProperties": false
}
