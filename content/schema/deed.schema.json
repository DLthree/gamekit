{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "needs": {
      "type": "object",
      "properties": {
        "won": {
          "type": "boolean",
          "const": true
        },
        "threat": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "kills": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "enum": [
                "fodder",
                "elite",
                "boss"
              ]
            },
            "count": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "role",
            "count"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "name",
    "text",
    "needs"
  ],
  "additionalProperties": false
}
