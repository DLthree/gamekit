{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "attack",
          "spell",
          "melee",
          "projectile",
          "area",
          "duration",
          "fire",
          "physical"
        ]
      }
    },
    "activation": {
      "type": "string",
      "enum": [
        "auto",
        "manual"
      ]
    },
    "target": {
      "type": "string",
      "enum": [
        "nearest",
        "aim",
        "player"
      ]
    },
    "stats": {
      "type": "object",
      "properties": {
        "damage": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "physical",
              "fire"
            ]
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "range": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "knockback": {
          "type": "number",
          "minimum": 0
        },
        "cooldown": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "area": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pulse": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "projectileSpeed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "projectileCount": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "spread": {
          "type": "number",
          "minimum": 0
        },
        "pierce": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "damage",
        "range",
        "knockback"
      ],
      "additionalProperties": false
    },
    "deliver": {
      "$ref": "#/$defs/__schema0"
    }
  },
  "required": [
    "$schema",
    "tags",
    "activation",
    "target",
    "stats",
    "deliver"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "projectile"
            },
            "multishot": {
              "type": "string",
              "enum": [
                "fan",
                "nearest",
                "nova",
                "scatter"
              ]
            },
            "vfx": {
              "type": "string",
              "minLength": 1
            },
            "radius": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "impact": {
              "type": "string",
              "enum": [
                "damage",
                "trigger"
              ]
            },
            "damageScale": {
              "default": 1,
              "type": "number",
              "exclusiveMinimum": 0
            },
            "onEnd": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "do",
            "multishot",
            "vfx",
            "radius",
            "impact"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "burst"
            },
            "vfx": {
              "type": "string",
              "minLength": 1
            },
            "shape": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "circle"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "arc"
                    },
                    "halfAngleDeg": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 180
                    }
                  },
                  "required": [
                    "kind",
                    "halfAngleDeg"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "lane"
                    }
                  },
                  "required": [
                    "kind"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "areaScale": {
              "default": 1,
              "type": "number",
              "exclusiveMinimum": 0
            },
            "damageScale": {
              "default": 1,
              "type": "number",
              "exclusiveMinimum": 0
            },
            "hitStop": {
              "default": false,
              "type": "boolean"
            },
            "warn": {
              "default": 0,
              "type": "number",
              "minimum": 0
            },
            "cancelOnOwnerDeath": {
              "default": false,
              "type": "boolean"
            },
            "at": {
              "default": "self",
              "type": "string",
              "enum": [
                "self",
                "target"
              ]
            },
            "count": {
              "default": 1,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "scatter": {
              "default": 0,
              "type": "number",
              "minimum": 0
            },
            "onEnd": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "do",
            "vfx",
            "shape"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "zone"
            },
            "vfx": {
              "type": "string",
              "minLength": 1
            },
            "motion": {
              "type": "string",
              "enum": [
                "static"
              ]
            },
            "areaScale": {
              "default": 1,
              "type": "number",
              "exclusiveMinimum": 0
            },
            "damageScale": {
              "default": 1,
              "type": "number",
              "exclusiveMinimum": 0
            },
            "onEnd": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "do",
            "vfx",
            "motion"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "do": {
              "type": "string",
              "const": "dash"
            },
            "onEnd": {
              "default": [],
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "do"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
