{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "volume": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sounds": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "cap": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "minGapS": {
            "type": "number",
            "minimum": 0
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "pitch": {
            "type": "number",
            "minimum": 0,
            "maximum": 12
          },
          "loop": {
            "type": "boolean"
          }
        },
        "required": [
          "cap",
          "minGapS",
          "volume",
          "pitch",
          "loop"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "volume",
    "sounds"
  ],
  "additionalProperties": false
}
