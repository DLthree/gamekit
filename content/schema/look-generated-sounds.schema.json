{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "sounds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "lengthS": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "file",
          "lengthS"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "sounds"
  ],
  "additionalProperties": false
}
