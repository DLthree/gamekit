{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "from": {
      "type": "string",
      "minLength": 1
    },
    "durationS": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "armed": {
      "type": "boolean"
    },
    "hold": {
      "type": "boolean"
    },
    "actors": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "enemy": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "respawnS": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "enemy",
          "x",
          "y"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "$schema",
    "name",
    "from",
    "durationS",
    "armed",
    "hold",
    "actors"
  ],
  "additionalProperties": false
}
