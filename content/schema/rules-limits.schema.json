      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "volumes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "events": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "hits": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
