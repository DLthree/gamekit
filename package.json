{
  "name": "gamekit",
  "version": "0.1.0",
  "main": "desktop/dist/main.cjs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=26.10.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode release",
    "preview": "vite preview --mode release",
    "desktop:compile": "node --import ./scripts/node-alias.ts scripts/desktop-build.ts compile",
    "desktop": "pnpm build && pnpm desktop:compile --itch && electron .",
    "desktop:steam": "pnpm build && pnpm desktop:compile --steam && electron .",
    "desktop:dist": "pnpm build && node --import ./scripts/node-alias.ts scripts/desktop-build.ts dist",
    "desktop:smoke": "pnpm build && pnpm desktop:compile --itch && pnpm e2e --config playwright.desktop.config.ts",
    "steam:achievements": "node --import ./scripts/node-alias.ts scripts/steam-dashboard.ts",
    "steam:upload": "node --import ./scripts/node-alias.ts scripts/steam-upload.ts",
    "itch:push": "node --import ./scripts/node-alias.ts scripts/itch-push.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:py": "uv run --no-project --with pytest==9.1.1 --with pillow==12.3.0 pytest -q -p no:cacheprovider scripts",
    "content:check": "node --import ./scripts/node-alias.ts scripts/content-check.ts",
    "content:schema": "node --import ./scripts/node-alias.ts scripts/content-check.ts --write-schemas",
    "telemetry": "node --import ./scripts/node-alias.ts scripts/telemetry.ts",
    "shot": "node --import ./scripts/node-alias.ts scripts/shot.ts",
    "phone": "node --import ./scripts/node-alias.ts scripts/phone.ts",
    "perf": "node --import ./scripts/node-alias.ts scripts/perf.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm content:check && pnpm test && pnpm test:py",
    "atlas": "uv run scripts/build_atlas.py",
    "sounds": "scripts/build-sounds.sh",
    "sounds:manifest": "node --import ./scripts/node-alias.ts scripts/sound-manifest.ts",
    "sound-sheet": "node --import ./scripts/node-alias.ts scripts/sound-sheet.ts",
    "e2e": "node --import ./scripts/node-alias.ts scripts/e2e.ts",
    "verify": "pnpm check && pnpm e2e",
    "film": "node --import ./scripts/node-alias.ts scripts/film.ts",
    "ticks": "node --import ./scripts/node-alias.ts scripts/ticks.ts",
    "screens": "node --import ./scripts/node-alias.ts scripts/screens.ts",
    "sweep": "node --import ./scripts/node-alias.ts scripts/sweep.ts",
    "run-record": "node --import ./scripts/node-alias.ts scripts/run-record.ts",
    "perf:check": "node --import ./scripts/node-alias.ts scripts/perf.ts --check",
    "store-media": "node --import ./scripts/node-alias.ts scripts/store-media.ts",
    "deck:check": "node --import ./scripts/node-alias.ts scripts/deck-check.ts"
  },
  "dependencies": {
    "phaser": "4.2.1",
    "steamworks-ffi-node": "0.11.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
